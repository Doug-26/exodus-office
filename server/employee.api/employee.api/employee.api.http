@host = https://localhost:7269

### List employees
GET {{host}}/api/v1/employees
Accept: application/json

### Get one employee
GET {{host}}/api/v1/employees/1
Accept: application/json

### Create an employee
POST {{host}}/api/v1/employees
Content-Type: application/json

{
  "name": "Maria Santos",
  "mobile": "9171234567",
  "email": "maria.santos@example.com",
  "city": "Naga",
  "region": "Bicol",
  "address": "Concepcion Pequeña"
}

### Update an employee (every field is replaced)
PUT {{host}}/api/v1/employees/1
Content-Type: application/json

{
  "name": "Maria Santos-Reyes",
  "mobile": "9171234567",
  "email": "maria.santos@example.com",
  "city": "Legazpi",
  "region": "Bicol",
  "address": "Old Albay"
}

### Delete an employee
DELETE {{host}}/api/v1/employees/1

### Validation failure example (expects 400 with a validation problem)
POST {{host}}/api/v1/employees
Content-Type: application/json

{
  "name": "A",
  "mobile": "123",
  "email": "not-an-email",
  "city": "",
  "region": "",
  "address": ""
}
